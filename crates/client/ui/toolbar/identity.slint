import { Layout } from "../layout.slint";
import { IdentityCard } from "identity/card.slint";
import { IdentityMenu } from "identity/menu.slint";

export component Identity inherits Rectangle {
    width: card.width;

    card := IdentityCard {
        height: root.height;
        clicked => { menu.show(); }
    }

    menu := IdentityMenu {
        x: root.width - Layout.menu-width;
        y: root.height;
    }
}
