import { Divider } from "../widgets/divider.slint";
import { Form } from "form.slint";
import { Register } from "register.slint";
import { Accounts } from "accounts.slint";
import { Tabs, LoginTab } from "tabs.slint";
import { Layout } from "../layout.slint";
import { Theme } from "../theme.slint";
import { Session, Entry } from "../state/session.slint";

export component Login inherits Rectangle {
    property <[Entry]> accounts;
    property <LoginTab> tab;

    init => {
        root.accounts = Session.accounts();
    }

    function remove(key: string) {
        Session.remove(key);
        root.accounts = Session.accounts();
    }

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: Layout.card-width;
                background: Theme.colors.surface;
                border-width: Layout.border-width;
                border-color: Theme.colors.border;

                VerticalLayout {
                    padding: Layout.card-padding;
                    spacing: Layout.spacing;

                    HorizontalLayout {
                        alignment: center;

                        Image {
                            source: @image-url("@assets/logo.png");
                            height: Layout.logo-height;
                            width: self.height * self.source.width / self.source.height;
                        }
                    }

                    Divider {}

                    Tabs {
                        current <=> root.tab;
                    }

                    if root.tab == LoginTab.login: Form {}

                    if root.tab == LoginTab.register: Register {}

                    if root.tab == LoginTab.accounts: Accounts {
                        accounts: root.accounts;
                        removed(key) => { root.remove(key); }
                    }
                }
            }
        }
    }
}
