import { Layout } from "../layout.slint";
import { Theme } from "../theme.slint";

export enum ButtonKind { action, normal, danger }

export component Button inherits Rectangle {
    in property <string> text;
    in property <ButtonKind> kind: ButtonKind.action;
    callback clicked <=> touch.clicked;

    background: root.fill(touch.has-hover);
    border-width: Layout.border-width;
    border-color: Theme.colors.border;

    function fill(hovered: bool) -> color {
        if root.kind == ButtonKind.action {
            return hovered ? Theme.colors.accent-hover : Theme.colors.accent;
        }
        if root.kind == ButtonKind.danger {
            return hovered ? Theme.colors.danger : Theme.colors.surface;
        }
        return hovered ? Theme.colors.surface-hover : Theme.colors.surface;
    }

    HorizontalLayout {
        padding-top: Layout.control-padding;
        padding-bottom: Layout.control-padding;
        padding-left: Layout.control-padding * 2;
        padding-right: Layout.control-padding * 2;

        Text {
            text: root.text;
            color: Theme.colors.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}
