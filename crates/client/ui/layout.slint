export global Layout {
    out property <length> window-width: 1100px;
    out property <length> window-height: 700px;
    out property <length> window-min-width: 640px;
    out property <length> window-min-height: 480px;

    out property <length> spacing: 12px;
    out property <length> border-width: 1px;
    out property <length> control-padding: 8px;
    out property <length> icon-size: 16px;

    out property <length> card-width: 400px;
    out property <length> card-padding: 24px;

    out property <length> logo-height: 64px;

    out property <length> busy-bar-height: 3px;
    out property <float> busy-bar-fraction: 0.3;
    out property <duration> busy-bar-period: 1500ms;
}
